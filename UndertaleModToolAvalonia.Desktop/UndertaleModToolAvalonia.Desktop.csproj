<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>UndertaleModToolAvalonia.Desktop</RootNamespace>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <NativeLibPath>$(MSBuildProjectDirectory)/libs</NativeLibPath>
    <NativeSrc>miniaudio.c</NativeSrc>
    <NativeOut>miniaudio.o</NativeOut>
    <VsWherePath Condition="'$(VsWherePath)' == ''">$(MSBuildProgramFiles32)\Microsoft Visual Studio\Installer\vswhere.exe</VsWherePath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishAot>true</PublishAot>
    <PublishTrimmed>true</PublishTrimmed>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>
  <ItemGroup>
    <TrimmerRootAssembly Include="UndertaleModToolAvalonia" />
    <TrimmerRootAssembly Include="UndertaleModLib" />
  </ItemGroup>
  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <Target Name="CompileNativeWindows" BeforeTargets="BeforeBuild;Build;Publish" Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Windows)))' == 'true'">
    <Message Text="[AudioLib] Compiling for Windows (MSVC)..." Importance="high" />
    <MakeDir Directories="$(NativeLibPath)" />
    <Exec Condition="Exists('$(VsWherePath)')"
          Command="&quot;$(VsWherePath)&quot; -latest -products * -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -property installationPath"
          ConsoleToMSBuild="true" StandardOutputImportance="low" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="VsInstallPath" />
    </Exec>
    <PropertyGroup>
      <VcVarsPath>$(VsInstallPath)\VC\Auxiliary\Build\vcvars64.bat</VcVarsPath>
      <VcVarsCall Condition="'$(VsInstallPath)' != '' And Exists('$(VcVarsPath)')">call &quot;$(VcVarsPath)&quot; &gt;nul &amp;&amp; </VcVarsCall>
    </PropertyGroup>
    <Exec Condition="'$(VcVarsCall)' == ''" Command="where cl.exe" IgnoreExitCode="true"
          StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="ClOnPathExitCode" />
    </Exec>
    <Error Condition="'$(VcVarsCall)' == '' And '$(ClOnPathExitCode)' != '0'"
           Text="[AudioLib] Couldn't find the Visual Studio C compiler (cl.exe). Install Visual Studio or the Visual Studio Build Tools with the 'Desktop development with C++' workload, or build from a Developer PowerShell." />
    <Exec Command="$(VcVarsCall)cl.exe /c &quot;$(NativeSrc)&quot; /Fo&quot;$(NativeLibPath)/miniaudio.obj&quot; /O2 &amp;&amp; lib.exe /OUT:&quot;$(NativeLibPath)/miniaudio.lib&quot; &quot;$(NativeLibPath)/miniaudio.obj&quot; &amp;&amp; cl.exe /LD &quot;$(NativeSrc)&quot; /Fe&quot;$(NativeLibPath)/AudioLib.dll&quot; /O2"
          WorkingDirectory="$(MSBuildProjectDirectory)" />
    <Copy SourceFiles="$(NativeLibPath)/AudioLib.dll"
          DestinationFolder="$(OutputPath)"
          Condition="'$(PublishAot)' != 'true' And Exists('$(NativeLibPath)/AudioLib.dll')" />
  </Target>
  <Target Name="CompileNativeLinux" BeforeTargets="BeforeBuild;Build;Publish" Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Linux)))' == 'true'">
    <Message Text="[AudioLib] Compiling for Linux (GCC)..." Importance="high" />
    <MakeDir Directories="$(NativeLibPath)" />
    <Exec Command="gcc -g -c &quot;$(NativeSrc)&quot; -o &quot;$(NativeLibPath)/miniaudio.o&quot; -O3 -fPIC"
          WorkingDirectory="$(MSBuildProjectDirectory)" />
    <Exec Command="gcc -shared -o &quot;$(NativeLibPath)/libAudioLib.so&quot; &quot;$(NativeLibPath)/miniaudio.o&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)" />
    <Copy SourceFiles="$(NativeLibPath)/libAudioLib.so"
          DestinationFolder="$(OutputPath)"
          Condition="'$(PublishAot)' != 'true' And Exists('$(NativeLibPath)/libAudioLib.so')" />
  </Target>
  <Target Name="CompileNativeMacOS" BeforeTargets="BeforeBuild;Build;Publish" Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::OSX)))' == 'true'">
    <Message Text="[AudioLib] Compiling for macOS (Clang)..." Importance="high" />
    <MakeDir Directories="$(NativeLibPath)" />
    <Exec Command="clang -g -c &quot;$(NativeSrc)&quot; -o &quot;$(NativeLibPath)/miniaudio.o&quot; -O3 -fPIC -arch arm64 -arch x86_64 -mmacosx-version-min=12.0"
          WorkingDirectory="$(MSBuildProjectDirectory)" />
    <Exec Command="clang -dynamiclib -o &quot;$(NativeLibPath)/libAudioLib.dylib&quot; &quot;$(NativeLibPath)/miniaudio.o&quot; -arch arm64 -arch x86_64 -mmacosx-version-min=12.0 -lpthread -lm"
          WorkingDirectory="$(MSBuildProjectDirectory)" />
    <Copy SourceFiles="$(NativeLibPath)/libAudioLib.dylib"
          DestinationFolder="$(OutputPath)"
          Condition="'$(PublishAot)' != 'true' And Exists('$(NativeLibPath)/libAudioLib.dylib')" />
  </Target>
  <ItemGroup>
    <NativeLibrary Include="libs/miniaudio.obj" Condition="'$(PublishAot)' == 'true' And '$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Windows)))' == 'true'" />
    <NativeLibrary Include="libs/miniaudio.o" Condition="'$(PublishAot)' == 'true' And '$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Windows)))' != 'true'" />
    <DirectPInvoke Include="AudioLib" Condition="'$(PublishAot)' == 'true'" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
    <PackageReference Include="Avalonia.LinuxFramebuffer" Version="12.1.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\UndertaleModToolAvalonia\UndertaleModToolAvalonia.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\UndertaleModTool\Scripts\**" Link="Scripts\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>