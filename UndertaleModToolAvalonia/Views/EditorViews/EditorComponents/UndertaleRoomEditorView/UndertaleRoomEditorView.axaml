<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:UndertaleModToolAvalonia.ViewModels.EditorViewModels.EditorComponents.UndertaleRoomEditorViewModel"
             xmlns:undertale="using:UndertaleModLib.Models"
             xmlns:converters="using:UndertaleModToolAvalonia.Converters"
             xmlns:controlConverters="using:UndertaleModToolAvalonia.Converters.ControlConverters"
             xmlns:local="using:UndertaleModToolAvalonia.Views.EditorViews.EditorComponents.UndertaleRoomEditorView"
             xmlns:controls="using:UndertaleModToolAvalonia.Controls"
             xmlns:app="using:UndertaleModToolAvalonia"
             xmlns:paz="using:Avalonia.Controls.PanAndZoom"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="UndertaleModToolAvalonia.Views.EditorViews.EditorComponents.UndertaleRoomEditorView.UndertaleRoomEditorView"
             x:DataType="vm:UndertaleRoomEditorViewModel">
    <UserControl.Resources>
        <ResourceDictionary>
            <converters:GameObjectToStringConverter x:Key="GameObjectToStringConverter"/>
            <controlConverters:IsGMS2Converter x:Key="IsGMS2Converter"/>
            <controlConverters:NonexistentColorConverter x:Key="NonexistentColorConverter"/>
            <controlConverters:EnabledColorConverter x:Key="EnabledColorConverter"/>
            <controlConverters:MultiCollectionBinding x:Key="MultiCollectionBinding"/>
            <MenuFlyout x:Key="GameObjectsFlyout">
                <MenuItem Header="New object instance" Click="MenuItem_NewObjectInstance_Click"/>
                <MenuItem Header="Paste object instance" Click="MenuItem_Paste_Click" InputGesture="Ctrl+V"/>
            </MenuFlyout>
            <controlConverters:LayerTypeConverter x:Key="LayerTypeConverter"/>
            <converters:IsVersionAtLeastConverter x:Key="IsVersionAtLeastConverter"/>
            <controlConverters:RoomGridBrushConverter x:Key="RoomGridBrushConverter"/>
            <converters:CachedTileImageLoader x:Key="CachedTileImageLoader"/>
            <converters:CachedImageLoaderWithIndex x:Key="CachedImageLoaderWithIndex"/>
            <converters:CachedTileDataLoader x:Key="CachedTileDataLoader"/>
            <app:NegateNumberConverter x:Key="NegateNumberConverter"/>
            <controlConverters:BGColorConverter x:Key="BGColorConverter"/>
            <controlConverters:ColorToOpacityConverter x:Key="ColorToOpacityConverter"/>
            <controlConverters:LayerItemsSourceConverter x:Key="LayerItemsSourceConverter"/>
            <controlConverters:RoomObjectTransformConverter x:Key="RoomObjectTransformConverter"/>
            <controlConverters:ParticleSystemRectConverter x:Key="ParticleSystemRectConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector=":is(Control).flash">
            <Style.Animations>
                <Animation Duration="0:0:0.75" IterationCount="INFINITE" PlaybackDirection="Alternate" Easing="CubicEaseIn">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="1"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="342"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Column="0" Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TreeView Grid.Column="0" Margin="0,0,3,0" Name="RoomObjectsTree" SelectionChanged="RoomObjectsTree_SelectionChanged"
                      KeyDown="RoomObjectsTree_KeyDown" DoubleTapped="RoomObjectsTree_DoubleTapped" PointerPressed="RoomObjectsTree_PointerPressed">
                <TreeView.DataTemplates>
                    <DataTemplate DataType="{x:Type undertale:UndertaleRoom+GameObject}">
                        <TextBlock Background="Transparent"
                                   Foreground="{Binding Nonexistent, Converter={StaticResource NonexistentColorConverter}}">
                            <TextBlock.Text>
                                <MultiBinding Mode="OneWay" Converter="{StaticResource GameObjectToStringConverter}">
                                    <Binding Path="." Mode="OneWay"/>
                                    <Binding Path="InstanceID" Mode="OneWay"/>
                                    <Binding Path="ObjectDefinition.Name.Content" Mode="OneWay" TargetNullValue="?" FallbackValue="EmptyInstance"/>
                                </MultiBinding>
                            </TextBlock.Text>
                            <TextBlock.ContextFlyout>
                                <MenuFlyout>
                                    <MenuItem Header="Copy object" Click="MenuItem_Copy_Click" InputGesture="Ctrl+C"/>
                                    <MenuItem Header="Delete object" Click="MenuItem_Delete_Click" InputGesture="Delete"/>
                                </MenuFlyout>
                            </TextBlock.ContextFlyout>
                        </TextBlock>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type undertale:UndertaleRoom+Tile}">
                        <TextBlock>
                            <TextBlock.Text>
                                <MultiBinding Mode="OneWay" StringFormat="{}Tile {0} of {1}">
                                    <Binding Path="InstanceID" Mode="OneWay"/>
                                    <Binding Path="ObjectDefinition.Name.Content" Mode="OneWay" TargetNullValue="?" FallbackValue="EmptyTile"/>
                                </MultiBinding>
                            </TextBlock.Text>
                            <TextBlock.ContextFlyout>
                                <MenuFlyout>
                                    <MenuItem Header="Copy tile" Click="MenuItem_Copy_Click" InputGesture="Ctrl+C"/>
                                    <MenuItem Header="Delete tile" Click="MenuItem_Delete_Click" InputGesture="Delete"/>
                                </MenuFlyout>
                            </TextBlock.ContextFlyout>
                        </TextBlock>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type undertale:UndertaleRoom+SpriteInstance}">
                        <TextBlock>
                            <TextBlock.Text>
                                <MultiBinding Mode="OneWay" StringFormat="{}Sprite {0} of {1}">
                                    <Binding Path="Name.Content" Mode="OneWay" TargetNullValue="?" FallbackValue="EmptyName"/>
                                    <Binding Path="Sprite.Name.Content" Mode="OneWay" TargetNullValue="?" FallbackValue="EmptySprite"/>
                                </MultiBinding>
                            </TextBlock.Text>
                            <TextBlock.ContextFlyout>
                                <MenuFlyout>
                                    <MenuItem Header="Copy sprite instance" Click="MenuItem_Copy_Click" InputGesture="Ctrl+C"/>
                                    <MenuItem Header="Delete sprite instance" Click="MenuItem_Delete_Click" InputGesture="Delete"/>
                                </MenuFlyout>
                            </TextBlock.ContextFlyout>
                        </TextBlock>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type undertale:UndertaleRoom+ParticleSystemInstance}">
                        <TextBlock>
                            <TextBlock.Text>
                                <MultiBinding Mode="OneWay" StringFormat="{}Particle system {0} of {1}">
                                    <Binding Path="Name.Content" Mode="OneWay" TargetNullValue="?" FallbackValue="EmptyName"/>
                                    <Binding Path="ParticleSystem.Name.Content" Mode="OneWay" TargetNullValue="?" FallbackValue="EmptySystem"/>
                                </MultiBinding>
                            </TextBlock.Text>
                            <TextBlock.ContextFlyout>
                                <MenuFlyout>
                                    <MenuItem Header="Copy particle system instance" Click="MenuItem_Copy_Click" InputGesture="Ctrl+C"/>
                                    <MenuItem Header="Delete particle system instance" Click="MenuItem_Delete_Click" InputGesture="Delete"/>
                                </MenuFlyout>
                            </TextBlock.ContextFlyout>
                        </TextBlock>
                    </DataTemplate>
                </TreeView.DataTemplates>
                
                <TreeViewItem Header="{Binding Room.Name.Content}" Name="RoomRootItem" IsExpanded="True" Background="Transparent">
                    <TreeViewItem Name="BGItems" Header="Backgrounds" ItemsSource="{Binding Room.Backgrounds, Mode=OneWay}" IsVisible="{Binding Room.Flags, Mode=OneTime, Converter={StaticResource IsGMS2Converter}}" IsExpanded="True" Background="Transparent">
                        <TreeViewItem.DataTemplates>
                            <DataTemplate DataType="{x:Type undertale:UndertaleRoom+Background}">
                                <TextBlock Text="{Binding BackgroundDefinition, Mode=OneWay, TargetNullValue='(no name)'}" Background="Transparent">
                                    <TextBlock.Foreground>
                                        <Binding Path="Enabled" Converter="{StaticResource EnabledColorConverter}"/>
                                    </TextBlock.Foreground>
                                    <TextBlock.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuItem Header="Delete background" Click="MenuItem_Delete_Click" InputGesture="Delete"/>
                                        </MenuFlyout>
                                    </TextBlock.ContextFlyout>
                                </TextBlock>
                            </DataTemplate>
                        </TreeViewItem.DataTemplates>
                    </TreeViewItem>
                    <TreeViewItem Name="ViewItems" Header="Views" ItemsSource="{Binding Room.Views, Mode=OneWay}" IsExpanded="True" Background="Transparent">
                        <TreeViewItem.DataTemplates>
                            <DataTemplate DataType="{x:Type undertale:UndertaleRoom+View}">
                                <TextBlock Text="View" Background="Transparent">
                                    <TextBlock.Foreground>
                                        <Binding Path="Enabled" Converter="{StaticResource EnabledColorConverter}"/>
                                    </TextBlock.Foreground>
                                    <TextBlock.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuItem Header="Disable view" Click="MenuItem_Delete_Click" InputGesture="Delete"/>
                                        </MenuFlyout>
                                    </TextBlock.ContextFlyout>
                                </TextBlock>
                            </DataTemplate>
                        </TreeViewItem.DataTemplates>
                    </TreeViewItem>
                    <TreeViewItem Name="GameObjItems" Header="{Binding GameObjectsHeader}" ItemsSource="{Binding Room.GameObjects, Mode=OneWay}" Background="Transparent"
                                  Foreground="{Binding IsNotGMS2Room, Converter={StaticResource EnabledColorConverter}}"/>
                    <TreeViewItem Name="TileItems" Header="Tiles" ItemsSource="{Binding Room.Tiles, Mode=OneWay}" IsVisible="{Binding Room.Flags, Mode=OneTime, Converter={StaticResource IsGMS2Converter}}" Background="Transparent">
                        <TreeViewItem.ContextFlyout>
                            <MenuFlyout>
                                <MenuItem Header="New tile" Click="MenuItem_NewGMS1Tile_Click"/>
                                <MenuItem Header="Paste tile" Click="MenuItem_Paste_Click" InputGesture="Ctrl+V"/>
                            </MenuFlyout>
                        </TreeViewItem.ContextFlyout>
                    </TreeViewItem>
                    <TreeViewItem Name="LayerItems" Header="Layers" ItemsSource="{Binding Room.Layers, Mode=OneWay}" IsExpanded="True" IsVisible="{Binding Room.Flags, Mode=OneTime, Converter={StaticResource IsGMS2Converter}, ConverterParameter=invert}" Background="Transparent">
                        <TreeViewItem.ContextFlyout>
                            <MenuFlyout>
                                <MenuItem Header="New Instances layer" Click="MenuItem_NewLayerInstances_Click"/>
                                <MenuItem Header="New Tiles layer" Click="MenuItem_NewLayerTiles_Click"/>
                                <MenuItem Header="New Background layer" Click="MenuItem_NewLayerBackground_Click"/>
                                <MenuItem Header="New Assets layer" Click="MenuItem_NewLayerAssets_Click"/>
                            </MenuFlyout>
                        </TreeViewItem.ContextFlyout>
                        <TreeViewItem.DataTemplates>
                            <local:LayerDataTemplateSelector>
                                <local:LayerDataTemplateSelector.PathDataTemplate>
                                    <TreeDataTemplate x:DataType="undertale:UndertaleRoom+Layer">
                                        <TextBlock Text="{Binding LayerName.Content, Mode=OneWay}" Background="Transparent"
                                                   Foreground="{Binding IsVisible, Converter={StaticResource EnabledColorConverter}}"/>
                                    </TreeDataTemplate>
                                </local:LayerDataTemplateSelector.PathDataTemplate>
                                <local:LayerDataTemplateSelector.InstancesDataTemplate>
                                    <TreeDataTemplate x:DataType="undertale:UndertaleRoom+Layer" ItemsSource="{Binding InstancesData.Instances, Mode=OneWay}">
                                        <TextBlock Text="{Binding LayerName.Content, Mode=OneWay}" Background="Transparent"
                                                   Foreground="{Binding IsVisible, Converter={StaticResource EnabledColorConverter}}">
                                            <TextBlock.ContextFlyout>
                                                <MenuFlyout>
                                                    <MenuItem Header="New object instance" Click="MenuItem_NewGMS2ObjectInstance_Click"/>
                                                    <MenuItem Header="Paste object instance" Click="MenuItem_Paste_Click" InputGesture="Ctrl+V"/>
                                                    <MenuItem Header="Delete layer" Click="MenuItem_Delete_Click" InputGesture="Delete"/>
                                                </MenuFlyout>
                                            </TextBlock.ContextFlyout>
                                        </TextBlock>
                                    </TreeDataTemplate>
                                </local:LayerDataTemplateSelector.InstancesDataTemplate>
                                <local:LayerDataTemplateSelector.TilesDataTemplate>
                                    <TreeDataTemplate x:DataType="undertale:UndertaleRoom+Layer">
                                        <TextBlock Text="{Binding LayerName.Content, Mode=OneWay}" Background="Transparent"
                                                   Foreground="{Binding IsVisible, Converter={StaticResource EnabledColorConverter}}">
                                            <TextBlock.ContextFlyout>
                                                <MenuFlyout>
                                                    <MenuItem Header="Delete layer" Click="MenuItem_Delete_Click" InputGesture="Delete"/>
                                                </MenuFlyout>
                                            </TextBlock.ContextFlyout>
                                        </TextBlock>
                                    </TreeDataTemplate>
                                </local:LayerDataTemplateSelector.TilesDataTemplate>
                                <local:LayerDataTemplateSelector.AssetsDataTemplate>
                                    <TreeDataTemplate x:DataType="undertale:UndertaleRoom+Layer">
                                        <TreeDataTemplate.ItemsSource>
                                            <MultiBinding Mode="OneWay" Converter="{StaticResource MultiCollectionBinding}">
                                                <Binding Path="AssetsData.LegacyTiles"/>
                                                <Binding Path="AssetsData.Sprites"/>
                                                <Binding Path="AssetsData.Sequences"/>
                                                <Binding Path="AssetsData.NineSlices"/>
                                                <Binding Path="AssetsData.ParticleSystems"/>
                                            </MultiBinding>
                                        </TreeDataTemplate.ItemsSource>
                                        <TextBlock Text="{Binding LayerName.Content, Mode=OneWay}" Background="Transparent"
                                                   Foreground="{Binding IsVisible, Converter={StaticResource EnabledColorConverter}}">
                                            <TextBlock.ContextFlyout>
                                                <MenuFlyout>
                                                    <MenuItem Header="New legacy tile" Click="MenuItem_NewLegacyTile_Click"/>
                                                    <MenuItem Header="New sprite instance" Click="MenuItem_NewSprite_Click"/>
                                                    <MenuItem Header="Paste asset" Click="MenuItem_Paste_Click" InputGesture="Ctrl+V"/>
                                                    <MenuItem Header="Delete layer" Click="MenuItem_Delete_Click" InputGesture="Delete"/>
                                                </MenuFlyout>
                                            </TextBlock.ContextFlyout>
                                        </TextBlock>
                                    </TreeDataTemplate>
                                </local:LayerDataTemplateSelector.AssetsDataTemplate>
                                <local:LayerDataTemplateSelector.BackgroundDataTemplate>
                                    <TreeDataTemplate x:DataType="undertale:UndertaleRoom+Layer">
                                        <TextBlock Text="{Binding LayerName.Content, Mode=OneWay}" Background="Transparent"
                                                   Foreground="{Binding IsVisible, Converter={StaticResource EnabledColorConverter}}">
                                            <TextBlock.ContextFlyout>
                                                <MenuFlyout>
                                                    <MenuItem Header="Delete layer" Click="MenuItem_Delete_Click" InputGesture="Delete"/>
                                                </MenuFlyout>
                                            </TextBlock.ContextFlyout>
                                        </TextBlock>
                                    </TreeDataTemplate>
                                </local:LayerDataTemplateSelector.BackgroundDataTemplate>
                                <local:LayerDataTemplateSelector.EffectDataTemplate>
                                    <TreeDataTemplate x:DataType="undertale:UndertaleRoom+Layer">
                                        <TextBlock Text="{Binding LayerName.Content, Mode=OneWay}" Background="Transparent"
                                                   Foreground="{Binding IsVisible, Converter={StaticResource EnabledColorConverter}}">
                                            <TextBlock.ContextFlyout>
                                                <MenuFlyout>
                                                    <MenuItem Header="Delete layer" Click="MenuItem_Delete_Click" InputGesture="Delete"/>
                                                </MenuFlyout>
                                            </TextBlock.ContextFlyout>
                                        </TextBlock>
                                    </TreeDataTemplate>
                                </local:LayerDataTemplateSelector.EffectDataTemplate>
                            </local:LayerDataTemplateSelector>
                        </TreeViewItem.DataTemplates>
                    </TreeViewItem>
                </TreeViewItem>
            </TreeView>

            <Border Grid.Column="1" BorderBrush="#828790" BorderThickness="0,1,1,1"
                    VerticalAlignment="Top" Margin="-3,0,0,0">
                <StackPanel Name="MoveButtonsPanel" Margin="1,1,1,1" IsEnabled="{Binding CanMoveSelectedObject}">
                    <RepeatButton FontSize="14" Content="&#x25B2;" Margin="0,0,0,2"
                                  ToolTip.Tip="Move item up (-)"
                                  Click="TreeViewMoveUpButton_Click"/>
                    <RepeatButton FontSize="14" Content="&#x25BC;"
                                  ToolTip.Tip="Move item down (+)"
                                  Click="TreeViewMoveDownButton_Click"/>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Column="2" Margin="3,0,0,0" Name="ObjectEditor" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible"
                          Content="{Binding SelectedObject}">
                <ScrollViewer.Styles>
                    <Style Selector="ScrollViewer#ObjectEditor TextBlock, ScrollViewer#ObjectEditor CheckBox">
                        <Setter Property="VerticalAlignment" Value="Center"/>
                    </Style>
                </ScrollViewer.Styles>
                <ScrollViewer.DataTemplates>
                    <DataTemplate DataType="{x:Type undertale:UndertaleRoom}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Margin="3">Name</TextBlock>
                            <controls:UndertaleStringReference Grid.Row="0" Grid.Column="2" Margin="3" ObjectReference="{Binding Name}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Margin="3">Caption</TextBlock>
                            <controls:UndertaleStringReference Grid.Row="1" Grid.Column="2" Margin="3" ObjectReference="{Binding Caption}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Margin="3">Size</TextBlock>
                            <Grid Grid.Row="2" Grid.Column="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Margin="3" Text="{Binding Width}"/>
                                <TextBox Grid.Column="1" Margin="3" Text="{Binding Height}"/>
                            </Grid>

                            <TextBlock Grid.Row="3" Grid.Column="0" Margin="3">Speed</TextBlock>
                            <TextBox Grid.Row="3" Grid.Column="2" Margin="3" Text="{Binding Speed}"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Margin="3">Persistent</TextBlock>
                            <CheckBox Grid.Row="4" Grid.Column="2" Margin="3" IsChecked="{Binding Persistent}"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Margin="3" IsVisible="{Binding Flags, Mode=OneTime, Converter={StaticResource IsGMS2Converter}}">Background color</TextBlock>
                            <controls:ColorPicker Grid.Row="5" Grid.Column="2" Margin="3" Color="{Binding BackgroundColor}" HasAlpha="False" IsVisible="{Binding Flags, Mode=OneTime, Converter={StaticResource IsGMS2Converter}}"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Margin="3" IsVisible="{Binding Flags, Mode=OneTime, Converter={StaticResource IsGMS2Converter}}">Draw background color</TextBlock>
                            <CheckBox Grid.Row="6" Grid.Column="2" Margin="3" IsChecked="{Binding DrawBackgroundColor}" IsVisible="{Binding Flags, Mode=OneTime, Converter={StaticResource IsGMS2Converter}}"/>

                            <TextBlock Grid.Row="7" Grid.Column="0" Margin="3">Creation Code</TextBlock>
                            <controls:UndertaleObjectReference Grid.Row="7" Grid.Column="2" Margin="3" ObjectReference="{Binding CreationCodeId}" ObjectType="{x:Type undertale:UndertaleCode}"
                                                               UndertaleData="{x:Static Member=app:AppConstants.Data}"
                                                               Room="{Binding}"/>

                            <TextBlock Grid.Row="8" Grid.Column="0" Margin="3">Flags</TextBlock>
                            <controls:FlagsBox Grid.Row="8" Grid.Column="2" Margin="3" Value="{Binding Flags, Converter={StaticResource IsGMS2Converter}, ConverterParameter=flags}"/>

                            <TextBlock Grid.Row="9" Grid.Column="0" Margin="3">World</TextBlock>
                            <TextBox Grid.Row="9" Grid.Column="2" Margin="3" Text="{Binding World}"/>

                            <TextBlock Grid.Row="10" Grid.Column="0" Margin="3">Top/Left/Right/Bottom</TextBlock>
                            <Grid Grid.Row="10" Grid.Column="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Margin="3" Text="{Binding Top}"/>
                                <TextBox Grid.Column="1" Margin="3" Text="{Binding Left}"/>
                                <TextBox Grid.Column="2" Margin="3" Text="{Binding Right}"/>
                                <TextBox Grid.Column="3" Margin="3" Text="{Binding Bottom}"/>
                            </Grid>

                            <TextBlock Grid.Row="11" Grid.Column="0" Margin="3">Gravity</TextBlock>
                            <Grid Grid.Row="11" Grid.Column="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Margin="3" Text="{Binding GravityX}" ToolTip.Tip="X"/>
                                <TextBox Grid.Column="1" Margin="3" Text="{Binding GravityY}" ToolTip.Tip="Y"/>
                            </Grid>

                            <TextBlock Grid.Row="12" Grid.Column="0" Margin="3">Grid Width</TextBlock>
                            <TextBox Grid.Row="12" Grid.Column="2" Margin="3" Text="{Binding GridWidth}"/>

                            <TextBlock Grid.Row="13" Grid.Column="0" Margin="3">Grid Height</TextBlock>
                            <TextBox Grid.Row="13" Grid.Column="2" Margin="3" Text="{Binding GridHeight}"/>

                            <TextBlock Grid.Row="14" Grid.Column="0" Margin="3">Grid Thickness</TextBlock>
                            <TextBox Grid.Row="14" Grid.Column="2" Margin="3" Text="{Binding GridThicknessPx}"/>
                        </Grid>
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type undertale:UndertaleRoom+Background}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Margin="3">Enabled</TextBlock>
                            <CheckBox Grid.Row="0" Grid.Column="2" Margin="3" IsChecked="{Binding Enabled}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Margin="3">Foreground</TextBlock>
                            <CheckBox Grid.Row="1" Grid.Column="2" Margin="3" IsChecked="{Binding Foreground}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Margin="3">Definition</TextBlock>
                            <controls:UndertaleObjectReference Grid.Row="2" Grid.Column="2" Margin="3" ObjectReference="{Binding BackgroundDefinition}" ObjectType="{x:Type undertale:UndertaleBackground}" CanRemove="True"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Margin="3">Position</TextBlock>
                            <Grid Grid.Row="3" Grid.Column="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Margin="3" Text="{Binding X}" ToolTip.Tip="X"/>
                                <TextBox Grid.Column="1" Margin="3" Text="{Binding Y}" ToolTip.Tip="Y"/>
                            </Grid>

                            <TextBlock Grid.Row="4" Grid.Column="0" Margin="3">Tiling</TextBlock>
                            <Grid Grid.Row="4" Grid.Column="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" Margin="3" IsChecked="{Binding TiledHorizontally}" ToolTip.Tip="Horizontal"/>
                                <CheckBox Grid.Column="1" Margin="3" IsChecked="{Binding TiledVertically}" ToolTip.Tip="Vertical"/>
                            </Grid>

                            <TextBlock Grid.Row="5" Grid.Column="0" Margin="3">Speed</TextBlock>
                            <Grid Grid.Row="5" Grid.Column="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Margin="3" Text="{Binding SpeedX}" ToolTip.Tip="X"/>
                                <TextBox Grid.Column="1" Margin="3" Text="{Binding SpeedY}" ToolTip.Tip="Y"/>
                            </Grid>

                            <TextBlock Grid.Row="6" Grid.Column="0" Margin="3">Stretch</TextBlock>
                            <CheckBox Grid.Row="6" Grid.Column="2" Margin="3" IsChecked="{Binding Stretch}"/>
                        </Grid>
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type undertale:UndertaleRoom+View}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Margin="3">Enabled</TextBlock>
                            <CheckBox Grid.Row="0" Grid.Column="2" Margin="3" IsChecked="{Binding Enabled}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Margin="3">Pos/size</TextBlock>
                            <Grid Grid.Row="1" Grid.Column="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Margin="3" Text="{Binding ViewX}" ToolTip.Tip="X"/>
                                <TextBox Grid.Column="1" Margin="3" Text="{Binding ViewY}" ToolTip.Tip="Y"/>
                                <TextBox Grid.Column="2" Margin="3" Text="{Binding ViewWidth}" ToolTip.Tip="Width"/>
                                <TextBox Grid.Column="3" Margin="3" Text="{Binding ViewHeight}" ToolTip.Tip="Height"/>
                            </Grid>

                            <TextBlock Grid.Row="2" Grid.Column="0" Margin="3">Port pos/size</TextBlock>
                            <Grid Grid.Row="2" Grid.Column="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Margin="3" Text="{Binding PortX}" ToolTip.Tip="X"/>
                                <TextBox Grid.Column="1" Margin="3" Text="{Binding PortY}" ToolTip.Tip="Y"/>
                                <TextBox Grid.Column="2" Margin="3" Text="{Binding PortWidth}" ToolTip.Tip="Width"/>
                                <TextBox Grid.Column="3" Margin="3" Text="{Binding PortHeight}" ToolTip.Tip="Height"/>
                            </Grid>

                            <TextBlock Grid.Row="3" Grid.Column="0" Margin="3">Border</TextBlock>
                            <Grid Grid.Row="3" Grid.Column="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Margin="3" Text="{Binding BorderX}" ToolTip.Tip="X"/>
                                <TextBox Grid.Column="1" Margin="3" Text="{Binding BorderY}" ToolTip.Tip="Y"/>
                            </Grid>

                            <TextBlock Grid.Row="4" Grid.Column="0" Margin="3">Speed</TextBlock>
                            <Grid Grid.Row="4" Grid.Column="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Margin="3" Text="{Binding SpeedX}" ToolTip.Tip="X"/>
                                <TextBox Grid.Column="1" Margin="3" Text="{Binding SpeedY}" ToolTip.Tip="Y"/>
                            </Grid>

                            <TextBlock Grid.Row="5" Grid.Column="0" Margin="3">Follows object</TextBlock>
                            <controls:UndertaleObjectReference Grid.Row="5" Grid.Column="2" Margin="3" ObjectReference="{Binding ObjectId}" ObjectType="{x:Type undertale:UndertaleGameObject}"/>
                        </Grid>
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type undertale:UndertaleRoom+GameObject}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Margin="3" Foreground="{Binding !Nonexistent, Converter={StaticResource EnabledColorConverter}}">Position</TextBlock>
                            <Grid Grid.Row="0" Grid.Column="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Margin="3" Text="{Binding X}" ToolTip.Tip="X" IsEnabled="{Binding !Nonexistent}"/>
                                <TextBox Grid.Column="1" Margin="3" Text="{Binding Y}" ToolTip.Tip="Y" IsEnabled="{Binding !Nonexistent}"/>
                            </Grid>

                            <TextBlock Grid.Row="1" Grid.Column="0" Margin="3" Foreground="{Binding !Nonexistent, Converter={StaticResource EnabledColorConverter}}">Definition</TextBlock>
                            <controls:UndertaleObjectReference Grid.Row="1" Grid.Column="2" Margin="3" ObjectReference="{Binding ObjectDefinition}" ObjectType="{x:Type undertale:UndertaleGameObject}" CanRemove="False" IsEnabled="{Binding !Nonexistent}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Margin="3" Foreground="{Binding !Nonexistent, Converter={StaticResource EnabledColorConverter}}">Instance ID</TextBlock>
                            <TextBox Grid.Row="2" Grid.Column="2" Margin="3" Text="{Binding InstanceID}" IsEnabled="{Binding !Nonexistent}"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Margin="3" Foreground="{Binding !Nonexistent, Converter={StaticResource EnabledColorConverter}}">Creation code</TextBlock>
                            <controls:UndertaleObjectReference Grid.Row="3" Grid.Column="2" Margin="3" ObjectReference="{Binding CreationCode}" ObjectType="{x:Type undertale:UndertaleCode}"
                                                               UndertaleData="{x:Static Member=app:AppConstants.Data}"
                                                               Room="{Binding $parent[UserControl].DataContext.(vm:UndertaleRoomEditorViewModel).Room}"
                                                               RoomGameObject="{Binding}"
                                                               IsPreCreate="False"
                                                               IsEnabled="{Binding !Nonexistent}"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Margin="3" Foreground="{Binding !Nonexistent, Converter={StaticResource EnabledColorConverter}}">Scale</TextBlock>
                            <Grid Grid.Row="4" Grid.Column="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Margin="3" Text="{Binding ScaleX}" ToolTip.Tip="X" IsEnabled="{Binding !Nonexistent}"/>
                                <TextBox Grid.Column="1" Margin="3" Text="{Binding ScaleY}" ToolTip.Tip="Y" IsEnabled="{Binding !Nonexistent}"/>
                            </Grid>

                            <TextBlock Grid.Row="5" Grid.Column="0" Margin="3" Foreground="{Binding !Nonexistent, Converter={StaticResource EnabledColorConverter}}">Color</TextBlock>
                            <controls:ColorPicker Grid.Row="5" Grid.Column="2" Margin="3" Color="{Binding Color}" IsEnabled="{Binding !Nonexistent}"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Margin="3" Foreground="{Binding !Nonexistent, Converter={StaticResource EnabledColorConverter}}">Rotation</TextBlock>
                            <TextBox Grid.Row="6" Grid.Column="2" Margin="3" Text="{Binding Rotation}" IsEnabled="{Binding !Nonexistent}"/>

                            <Grid Grid.Row="7" Grid.ColumnSpan="3" IsVisible="{Binding Mode=OneTime, Converter={StaticResource IsVersionAtLeastConverter}, ConverterParameter=2.2.2.302}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="5"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Margin="3" Foreground="{Binding !Nonexistent, Converter={StaticResource EnabledColorConverter}}">Frame index</TextBlock>
                                <TextBox Grid.Row="0" Grid.Column="2" Margin="3" Text="{Binding ImageIndex}" IsEnabled="{Binding !Nonexistent}"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Margin="3" Foreground="{Binding !Nonexistent, Converter={StaticResource EnabledColorConverter}}">Image speed</TextBlock>
                                <TextBox Grid.Row="1" Grid.Column="2" Margin="3" Text="{Binding ImageSpeed}" IsEnabled="{Binding !Nonexistent}"/>
                            </Grid>

                            <TextBlock Grid.Row="8" Grid.Column="0" Margin="3" Foreground="{Binding !Nonexistent, Converter={StaticResource EnabledColorConverter}}">Pre Create code</TextBlock>
                            <controls:UndertaleObjectReference Grid.Row="8" Grid.Column="2" Margin="3" ObjectReference="{Binding PreCreateCode}" ObjectType="{x:Type undertale:UndertaleCode}"
                                                               UndertaleData="{x:Static Member=app:AppConstants.Data}"
                                                               Room="{Binding $parent[UserControl].DataContext.(vm:UndertaleRoomEditorViewModel).Room}"
                                                               RoomGameObject="{Binding}"
                                                               IsPreCreate="True"
                                                               IsEnabled="{Binding !Nonexistent}"/>
                        </Grid>
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type undertale:UndertaleRoom+Tile}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Margin="3">Position</TextBlock>
                            <Grid Grid.Row="0" Grid.Column="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Margin="3" Text="{Binding X}" ToolTip.Tip="X"/>
                                <TextBox Grid.Column="1" Margin="3" Text="{Binding Y}" ToolTip.Tip="Y"/>
                            </Grid>

                            <TextBlock Grid.Row="1" Grid.Column="0" Margin="3">Definition</TextBlock>
                            <controls:UndertaleObjectReference Grid.Row="1" Grid.Column="2" Margin="3" ObjectReference="{Binding ObjectDefinition}" CanRemove="False"
                                                               ObjectType="{Binding $parent[UserControl].DataContext.(vm:UndertaleRoomEditorViewModel).TileDefinitionType, Mode=OneTime}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Margin="3">Source</TextBlock>
                            <Grid Grid.Row="2" Grid.Column="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Margin="3" Text="{Binding SourceX}" ToolTip.Tip="X"/>
                                <TextBox Grid.Column="1" Margin="3" Text="{Binding SourceY}" ToolTip.Tip="Y"/>
                                <TextBox Grid.Column="2" Margin="3" Text="{Binding Width}" ToolTip.Tip="Width"/>
                                <TextBox Grid.Column="3" Margin="3" Text="{Binding Height}" ToolTip.Tip="Height"/>
                            </Grid>

                            <TextBlock Grid.Row="3" Grid.Column="2" Margin="3" HorizontalAlignment="Center" Foreground="DarkGray" FontStyle="Italic" TextWrapping="Wrap">
                                Hint: You can select a tile by clicking on it.<LineBreak/>
                                To select a <Run FontWeight="DemiBold" Foreground="#FFB23131">region</Run> of tile, hold down ALT.
                            </TextBlock>
                            <Viewbox Grid.Row="4" Grid.Column="2" Margin="3" Stretch="Uniform" StretchDirection="DownOnly">
                                <Canvas Width="{Binding Tpag.BoundingWidth, Mode=OneWay}" Height="{Binding Tpag.BoundingHeight, Mode=OneWay}"
                                        PointerPressed="RectangleTile_PointerPressed" PointerMoved="RectangleTile_PointerMoved">
                                    <Border Background="{StaticResource TransparencyGridBrushBrush}" Tag="{Binding Tpag, Mode=OneWay}">
                                        <controls:UndertaleTexturePageItemDisplay TextureItem="{Binding $parent[Border].Tag}"
                                                                                  Editor="{Binding $parent[UserControl].DataContext.(vm:UndertaleRoomEditorViewModel).Editor}"
                                                                                  TextureCacheService="{Binding $parent[UserControl].DataContext.(vm:UndertaleRoomEditorViewModel).TextureCacheService}"
                                                                                  FileService="{Binding $parent[UserControl].DataContext.(vm:UndertaleRoomEditorViewModel).FileService}"/>
                                    </Border>
                                    <Rectangle Name="TileSelector" Canvas.Left="{Binding SourceX, Mode=OneWay}" Canvas.Top="{Binding SourceY, Mode=OneWay}"
                                               Width="{Binding Width, Mode=OneWay}" Height="{Binding Height, Mode=OneWay}"
                                               Stroke="#FFB23131" ZIndex="50" StrokeThickness="2" IsHitTestVisible="False">
                                        <Rectangle.Fill>
                                            <SolidColorBrush Color="Red" Opacity=".1"/>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                </Canvas>
                            </Viewbox>

                            <TextBlock Grid.Row="5" Grid.Column="0" Margin="3">Depth</TextBlock>
                            <TextBox Grid.Row="5" Grid.Column="2" Margin="3" Text="{Binding TileDepth}"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Margin="3">Instance ID</TextBlock>
                            <TextBox Grid.Row="6" Grid.Column="2" Margin="3" Text="{Binding InstanceID}"/>

                            <TextBlock Grid.Row="7" Grid.Column="0" Margin="3">Scale</TextBlock>
                            <Grid Grid.Row="7" Grid.Column="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Margin="3" Text="{Binding ScaleX}" ToolTip.Tip="X"/>
                                <TextBox Grid.Column="1" Margin="3" Text="{Binding ScaleY}" ToolTip.Tip="Y"/>
                            </Grid>

                            <TextBlock Grid.Row="8" Grid.Column="0" Margin="3">Color</TextBlock>
                            <controls:ColorPicker Grid.Row="8" Grid.Column="2" Margin="3" Color="{Binding Color}"/>
                        </Grid>
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type undertale:UndertaleRoom+Layer}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Margin="3">Layer name</TextBlock>
                            <controls:UndertaleStringReference Grid.Row="0" Grid.Column="2" Margin="3" ObjectReference="{Binding LayerName}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Margin="3">Layer id</TextBlock>
                            <TextBox Grid.Row="1" Grid.Column="2" Margin="3" Text="{Binding LayerId}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Margin="3">Layer type</TextBlock>
                            <TextBlock Grid.Row="2" Grid.Column="2" Margin="3" Text="{Binding LayerType}" FontWeight="Bold"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Margin="3">Depth</TextBlock>
                            <TextBox Grid.Row="3" Grid.Column="2" Margin="3" Text="{Binding LayerDepth}"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Margin="3" IsVisible="{Binding LayerType, Mode=OneTime, Converter={StaticResource LayerTypeConverter}}">Offset</TextBlock>
                            <Grid Grid.Row="4" Grid.Column="2" IsVisible="{Binding LayerType, Mode=OneTime, Converter={StaticResource LayerTypeConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Margin="3" Text="{Binding XOffset}" ToolTip.Tip="X"/>
                                <TextBox Grid.Column="1" Margin="3" Text="{Binding YOffset}" ToolTip.Tip="Y"/>
                            </Grid>

                            <TextBlock Grid.Row="5" Grid.Column="0" Margin="3" IsVisible="{Binding LayerType, Mode=OneTime, Converter={StaticResource LayerTypeConverter}}">Speed</TextBlock>
                            <Grid Grid.Row="5" Grid.Column="2" IsVisible="{Binding LayerType, Mode=OneTime, Converter={StaticResource LayerTypeConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Margin="3" Text="{Binding HSpeed}" ToolTip.Tip="Horizontal"/>
                                <TextBox Grid.Column="1" Margin="3" Text="{Binding VSpeed}" ToolTip.Tip="Vertical"/>
                            </Grid>

                            <TextBlock Grid.Row="6" Grid.Column="0" Margin="3">Visible</TextBlock>
                            <CheckBox Grid.Row="6" Grid.Column="2" Margin="3" IsChecked="{Binding IsVisible}"/>

                            <Separator Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="3"/>

                            <TextBlock Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3" Margin="3" Text="Empty layer data." IsVisible="{Binding Data, Converter={x:Static ObjectConverters.IsNull}}"/>
                            <ContentControl Name="LayerDataContent" Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3" Content="{Binding Data, Mode=OneTime}">
                                <ContentControl.DataTemplates>
                                    <DataTemplate DataType="{x:Type undertale:UndertaleRoom+Layer+LayerInstancesData}">
                                        <TextBlock Margin="3" Text="Contains GameObject instances, listed in the tree on the left"/>
                                    </DataTemplate>

                                    <DataTemplate DataType="{x:Type undertale:UndertaleRoom+Layer+LayerTilesData}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="5"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Margin="3">Size</TextBlock>
                                            <Grid Grid.Row="0" Grid.Column="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" Margin="3" Text="{Binding TilesX}" ToolTip.Tip="Horizontal"/>
                                                <TextBox Grid.Column="1" Margin="3" Text="{Binding TilesY}" ToolTip.Tip="Vertical"/>
                                                <Button Grid.Column="2" Margin="3" HorizontalAlignment="Stretch" Command="{Binding $parent[UserControl].DataContext.(vm:UndertaleRoomEditorViewModel).AutoSizeTilesCommand}" CommandParameter="{Binding}" ToolTip.Tip="Automatically set size to match room size">Auto</Button>
                                            </Grid>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Margin="3">Tile set</TextBlock>
                                            <controls:UndertaleObjectReference Grid.Row="1" Grid.Column="2" Margin="3" ObjectReference="{Binding Background}" ObjectType="{x:Type undertale:UndertaleBackground}" CanRemove="False"/>
                                        </Grid>
                                    </DataTemplate>

                                    <DataTemplate DataType="{x:Type undertale:UndertaleRoom+Layer+LayerBackgroundData}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="5"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Margin="3">Visible</TextBlock>
                                            <CheckBox Grid.Row="0" Grid.Column="2" Margin="3" IsChecked="{Binding Visible}"/>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Margin="3">Foreground</TextBlock>
                                            <CheckBox Grid.Row="1" Grid.Column="2" Margin="3" IsChecked="{Binding Foreground}"/>

                                            <TextBlock Grid.Row="2" Grid.Column="0" Margin="3">Sprite</TextBlock>
                                            <controls:UndertaleObjectReference Grid.Row="2" Grid.Column="2" Margin="3" ObjectReference="{Binding Sprite}" ObjectType="{x:Type undertale:UndertaleSprite}" CanRemove="False"/>

                                            <TextBlock Grid.Row="3" Grid.Column="0" Margin="3">Tiling</TextBlock>
                                            <Grid Grid.Row="3" Grid.Column="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0" Margin="3" IsChecked="{Binding TiledHorizontally}" ToolTip.Tip="Horizontal"/>
                                                <CheckBox Grid.Column="1" Margin="3" IsChecked="{Binding TiledVertically}" ToolTip.Tip="Vertical"/>
                                            </Grid>

                                            <TextBlock Grid.Row="4" Grid.Column="0" Margin="3">Stretch</TextBlock>
                                            <CheckBox Grid.Row="4" Grid.Column="2" Margin="3" IsChecked="{Binding Stretch}"/>

                                            <TextBlock Grid.Row="5" Grid.Column="0" Margin="3">Color</TextBlock>
                                            <controls:ColorPicker Grid.Row="5" Grid.Column="2" Margin="3" Color="{Binding Color}"/>

                                            <TextBlock Grid.Row="6" Grid.Column="0" Margin="3">First frame</TextBlock>
                                            <TextBox Grid.Row="6" Grid.Column="2" Margin="3" Text="{Binding FirstFrame}"/>

                                            <TextBlock Grid.Row="7" Grid.Column="0" Margin="3">Animation speed</TextBlock>
                                            <Grid Grid.Row="7" Grid.Column="2" Margin="3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="1*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" Text="{Binding AnimationSpeed}"/>
                                                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding $parent[UserControl].DataContext.(vm:UndertaleRoomEditorViewModel).AnimationSpeedTypes}" SelectedItem="{Binding AnimationSpeedType}"/>
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>

                                    <DataTemplate DataType="{x:Type undertale:UndertaleRoom+Layer+LayerAssetsData}">
                                        <TextBlock Margin="3" Text="Contains legacy tiles and sprites, listed in the tree on the left"/>
                                    </DataTemplate>
                                </ContentControl.DataTemplates>
                            </ContentControl>
                        </Grid>
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type undertale:UndertaleRoom+SpriteInstance}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Margin="3">Name</TextBlock>
                            <controls:UndertaleStringReference Grid.Row="0" Grid.Column="2" Margin="3" ObjectReference="{Binding Name}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Margin="3">Definition</TextBlock>
                            <controls:UndertaleObjectReference Grid.Row="1" Grid.Column="2" Margin="3" ObjectReference="{Binding Sprite}" ObjectType="{x:Type undertale:UndertaleSprite}" CanRemove="False"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Margin="3">Position</TextBlock>
                            <Grid Grid.Row="2" Grid.Column="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Margin="3" Text="{Binding X}" ToolTip.Tip="X"/>
                                <TextBox Grid.Column="1" Margin="3" Text="{Binding Y}" ToolTip.Tip="Y"/>
                            </Grid>

                            <TextBlock Grid.Row="3" Grid.Column="0" Margin="3">Scale</TextBlock>
                            <Grid Grid.Row="3" Grid.Column="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Margin="3" Text="{Binding ScaleX}" ToolTip.Tip="X"/>
                                <TextBox Grid.Column="1" Margin="3" Text="{Binding ScaleY}" ToolTip.Tip="Y"/>
                            </Grid>

                            <TextBlock Grid.Row="4" Grid.Column="0" Margin="3">Color</TextBlock>
                            <controls:ColorPicker Grid.Row="4" Grid.Column="2" Margin="3" Color="{Binding Color}"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Margin="3">Animation speed</TextBlock>
                            <Grid Grid.Row="5" Grid.Column="2" Margin="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding AnimationSpeed}"/>
                                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding $parent[UserControl].DataContext.(vm:UndertaleRoomEditorViewModel).AnimationSpeedTypes}" SelectedItem="{Binding AnimationSpeedType}"/>
                            </Grid>

                            <TextBlock Grid.Row="6" Grid.Column="0" Margin="3">Frame index</TextBlock>
                            <TextBox Grid.Row="6" Grid.Column="2" Margin="3" Text="{Binding FrameIndex}"/>

                            <TextBlock Grid.Row="7" Grid.Column="0" Margin="3">Rotation</TextBlock>
                            <TextBox Grid.Row="7" Grid.Column="2" Margin="3" Text="{Binding Rotation}"/>
                        </Grid>
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type undertale:UndertaleRoom+ParticleSystemInstance}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Margin="3">Name</TextBlock>
                            <controls:UndertaleStringReference Grid.Row="0" Grid.Column="2" Margin="3" ObjectReference="{Binding Name}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Margin="3">Definition</TextBlock>
                            <controls:UndertaleObjectReference Grid.Row="1" Grid.Column="2" Margin="3" ObjectReference="{Binding ParticleSystem}" ObjectType="{x:Type undertale:UndertaleParticleSystem}" CanRemove="False"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Margin="3">Position</TextBlock>
                            <Grid Grid.Row="2" Grid.Column="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Margin="3" Text="{Binding X}" ToolTip.Tip="X"/>
                                <TextBox Grid.Column="1" Margin="3" Text="{Binding Y}" ToolTip.Tip="Y"/>
                            </Grid>

                            <TextBlock Grid.Row="3" Grid.Column="0" Margin="3">Scale</TextBlock>
                            <Grid Grid.Row="3" Grid.Column="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Margin="3" Text="{Binding ScaleX}" ToolTip.Tip="X"/>
                                <TextBox Grid.Column="1" Margin="3" Text="{Binding ScaleY}" ToolTip.Tip="Y"/>
                            </Grid>

                            <TextBlock Grid.Row="4" Grid.Column="0" Margin="3">Color</TextBlock>
                            <controls:ColorPicker Grid.Row="4" Grid.Column="2" Margin="3" Color="{Binding Color}"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Margin="3">Rotation</TextBlock>
                            <TextBox Grid.Row="5" Grid.Column="2" Margin="3" Text="{Binding Rotation}"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Margin="3" IsVisible="{Binding Mode=OneTime, Converter={StaticResource IsVersionAtLeastConverter}, ConverterParameter=2024.14}">Instance ID</TextBlock>
                            <TextBox Grid.Row="6" Grid.Column="2" Margin="3" Text="{Binding InstanceID}" IsVisible="{Binding Mode=OneTime, Converter={StaticResource IsVersionAtLeastConverter}, ConverterParameter=2024.14}"/>
                        </Grid>
                    </DataTemplate>
                </ScrollViewer.DataTemplates>
            </ScrollViewer>
        </Grid>

        <GridSplitter Grid.Column="0" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" ResizeDirection="Rows" Height="3"/>

        <ScrollViewer Name="RoomGraphicsScroll" Margin="0,8,0,0" Grid.Column="0" Grid.Row="2" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible" AllowAutoHide="False">
            <paz:ZoomBorder Name="ZoomBorder" Stretch="None" ZoomSpeed="1.2" ClipToBounds="True" Focusable="True" Background="Gray"
                            VerticalAlignment="Stretch" HorizontalAlignment="Stretch" PanButton="Middle" DragDrop.AllowDrop="True"
                            PointerPressed="RoomGraphics_PointerPressed" PointerMoved="RoomGraphics_PointerMoved" PointerReleased="RoomGraphics_PointerReleased"
                            MinZoomX="0.001" MinZoomY="0.001" MaxZoomX="1000" MaxZoomY="1000">
                <Panel Name="RoomGraphics" Width="{Binding Room.Width, Mode=OneWay}" Height="{Binding Room.Height, Mode=OneWay}"
                       HorizontalAlignment="Left" VerticalAlignment="Top" RenderOptions.BitmapInterpolationMode="None">
                    <Panel.Background>
                        <MultiBinding Converter="{StaticResource BGColorConverter}">
                            <Binding Path="Room.Flags" Mode="OneTime"/>
                            <Binding Path="Room.BGColorLayer.BackgroundData.Color" Mode="OneWay"/>
                            <Binding Path="Room.BackgroundColor" Mode="OneWay"/>
                        </MultiBinding>
                    </Panel.Background>
                    <Panel.DataTemplates>
                        <DataTemplate DataType="{x:Type undertale:UndertaleRoom+Background}">
                            <controls:RoomBackgroundDisplay BackgroundObject="{Binding}" IsVisible="{Binding Enabled, Mode=OneWay}"/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type undertale:UndertaleRoom+Tile}">
                            <Image Width="{Binding Width, Mode=OneWay}" Height="{Binding Height, Mode=OneWay}" Stretch="Fill"
                                   RenderTransformOrigin="0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                   Opacity="{Binding Color, Mode=OneWay, Converter={StaticResource ColorToOpacityConverter}}">
                                <Image.Source>
                                    <MultiBinding Converter="{StaticResource CachedTileImageLoader}">
                                        <Binding Mode="OneTime"/>
                                        <Binding Path="Width" Mode="OneWay"/>
                                        <Binding Path="Height" Mode="OneWay"/>
                                        <Binding Path="Tpag" Mode="OneWay"/>
                                        <Binding Path="SourceX" Mode="OneWay"/>
                                        <Binding Path="SourceY" Mode="OneWay"/>
                                    </MultiBinding>
                                </Image.Source>
                                <Image.RenderTransform>
                                    <MultiBinding Converter="{StaticResource RoomObjectTransformConverter}">
                                        <Binding Mode="OneWay"/>
                                        <Binding Path="X" Mode="OneWay"/>
                                        <Binding Path="Y" Mode="OneWay"/>
                                        <Binding Path="ScaleX" Mode="OneWay"/>
                                        <Binding Path="ScaleY" Mode="OneWay"/>
                                    </MultiBinding>
                                </Image.RenderTransform>
                            </Image>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type undertale:UndertaleRoom+GameObject}">
                            <Image Stretch="None" RenderTransformOrigin="0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                   Opacity="{Binding Color, Mode=OneWay, Converter={StaticResource ColorToOpacityConverter}}">
                                <Image.Source>
                                    <MultiBinding Converter="{StaticResource CachedImageLoaderWithIndex}">
                                        <Binding Path="ObjectDefinition.Sprite.Textures" Mode="OneWay"/>
                                        <Binding Path="WrappedImageIndex" Mode="OneWay"/>
                                    </MultiBinding>
                                </Image.Source>
                                <Image.RenderTransform>
                                    <MultiBinding Converter="{StaticResource RoomObjectTransformConverter}">
                                        <Binding Mode="OneWay"/>
                                        <Binding Path="X" Mode="OneWay"/>
                                        <Binding Path="Y" Mode="OneWay"/>
                                        <Binding Path="ScaleX" Mode="OneWay"/>
                                        <Binding Path="ScaleY" Mode="OneWay"/>
                                        <Binding Path="Rotation" Mode="OneWay"/>
                                        <Binding Path="SpriteXOffset" Mode="OneWay"/>
                                        <Binding Path="SpriteYOffset" Mode="OneWay"/>
                                    </MultiBinding>
                                </Image.RenderTransform>
                            </Image>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type undertale:UndertaleRoom+SpriteInstance}">
                            <Image Stretch="None" RenderTransformOrigin="0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                   Opacity="{Binding Color, Mode=OneWay, Converter={StaticResource ColorToOpacityConverter}}">
                                <Image.Source>
                                    <MultiBinding Converter="{StaticResource CachedImageLoaderWithIndex}">
                                        <Binding Path="Sprite.Textures" Mode="OneWay"/>
                                        <Binding Path="WrappedFrameIndex" Mode="OneWay"/>
                                    </MultiBinding>
                                </Image.Source>
                                <Image.RenderTransform>
                                    <MultiBinding Converter="{StaticResource RoomObjectTransformConverter}">
                                        <Binding Mode="OneWay"/>
                                        <Binding Path="X" Mode="OneWay"/>
                                        <Binding Path="Y" Mode="OneWay"/>
                                        <Binding Path="ScaleX" Mode="OneWay"/>
                                        <Binding Path="ScaleY" Mode="OneWay"/>
                                        <Binding Path="Rotation" Mode="OneWay"/>
                                        <Binding Path="SpriteXOffset" Mode="OneWay"/>
                                        <Binding Path="SpriteYOffset" Mode="OneWay"/>
                                    </MultiBinding>
                                </Image.RenderTransform>
                            </Image>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type undertale:UndertaleRoom+ParticleSystemInstance}">
                            <Canvas Background="Transparent" RenderTransformOrigin="0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Opacity="{Binding Color, Mode=OneWay, Converter={StaticResource ColorToOpacityConverter}}">
                                <Canvas.RenderTransform>
                                    <MultiBinding Converter="{StaticResource RoomObjectTransformConverter}">
                                        <Binding Mode="OneWay"/>
                                        <Binding Path="X" Mode="OneWay"/>
                                        <Binding Path="Y" Mode="OneWay"/>
                                        <Binding Path="ScaleX" Mode="OneWay"/>
                                        <Binding Path="ScaleY" Mode="OneWay"/>
                                        <Binding Path="Rotation" Mode="OneWay"/>
                                    </MultiBinding>
                                </Canvas.RenderTransform>
                                <Ellipse Width="16" Height="16" Fill="Silver"/>

                                <Ellipse Canvas.Left="5" Canvas.Top="5" Width="3" Height="3" Fill="White"/>
                                <Line Canvas.Left="3.5" Canvas.Top="6.5" StartPoint="0,0" EndPoint="6,0" Stroke="White"/>
                                <Line Canvas.Left="6.5" Canvas.Top="3.5" StartPoint="0,0" EndPoint="0,6" Stroke="White"/>

                                <Ellipse Canvas.Left="9" Canvas.Top="9" Width="2" Height="2" Fill="White"/>
                                <Line Canvas.Left="8" Canvas.Top="10" StartPoint="0,0" EndPoint="4,0" Stroke="White"/>
                                <Line Canvas.Left="10" Canvas.Top="8" StartPoint="0,0" EndPoint="0,4" Stroke="White"/>

                                <Border BorderBrush="DarkCyan" BorderThickness="1" Background="Transparent"
                                        Canvas.Left="{Binding ParticleSystem, Mode=OneWay, Converter={StaticResource ParticleSystemRectConverter}, ConverterParameter=x}"
                                        Canvas.Top="{Binding ParticleSystem, Mode=OneWay, Converter={StaticResource ParticleSystemRectConverter}, ConverterParameter=y}"
                                        Width="{Binding ParticleSystem, Mode=OneWay, Converter={StaticResource ParticleSystemRectConverter}, ConverterParameter=width}"
                                        Height="{Binding ParticleSystem, Mode=OneWay, Converter={StaticResource ParticleSystemRectConverter}, ConverterParameter=height}"/>
                            </Canvas>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type undertale:UndertaleRoom+Layer+LayerBackgroundData}">
                            <controls:RoomBackgroundDisplay BackgroundObject="{Binding}" IsVisible="{Binding Visible, Mode=OneWay}"
                                                            Opacity="{Binding Color, Mode=OneWay, Converter={StaticResource ColorToOpacityConverter}}"/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type undertale:UndertaleRoom+Layer+LayerTilesData}">
                            <Image Width="{Binding ParentLayer.ParentRoom.Width, Mode=OneWay}" Height="{Binding ParentLayer.ParentRoom.Height, Mode=OneWay}"
                                   Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top">
                                <Image.Source>
                                    <MultiBinding Converter="{StaticResource CachedTileDataLoader}">
                                        <Binding Mode="OneTime"/>
                                        <Binding Path="TileData" Mode="OneWay"/>
                                    </MultiBinding>
                                </Image.Source>
                            </Image>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type undertale:UndertaleRoom+Layer}">
                            <ItemsControl ItemsSource="{Binding ., Mode=OneWay, Converter={StaticResource LayerItemsSourceConverter}}" RenderTransformOrigin="0,0"
                                          Width="{Binding ParentRoom.Width, Mode=OneWay}" Height="{Binding ParentRoom.Height, Mode=OneWay}"
                                          HorizontalAlignment="Left" VerticalAlignment="Top">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.RenderTransform>
                                    <MultiBinding Converter="{StaticResource RoomObjectTransformConverter}">
                                        <Binding Mode="OneWay"/>
                                        <Binding Path="XOffset" Mode="OneWay"/>
                                        <Binding Path="YOffset" Mode="OneWay"/>
                                    </MultiBinding>
                                </ItemsControl.RenderTransform>
                            </ItemsControl>
                        </DataTemplate>
                    </Panel.DataTemplates>

                    <ItemsControl Name="BackgroundGraphics" ItemsSource="{Binding Room.Backgrounds, Mode=OneWay}" IsVisible="{Binding Room.Flags, Mode=OneTime, Converter={StaticResource IsGMS2Converter}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <ItemsControl Name="TileGraphics" ItemsSource="{Binding Room.Tiles, Mode=OneWay}" IsVisible="{Binding Room.Flags, Mode=OneTime, Converter={StaticResource IsGMS2Converter}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <ItemsControl Name="GameObjectGraphics" ItemsSource="{Binding Room.GameObjects, Mode=OneWay}" IsVisible="{Binding Room.Flags, Mode=OneTime, Converter={StaticResource IsGMS2Converter}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <ItemsControl Name="LayerGraphics" ItemsSource="{Binding Room.Layers, Mode=OneWay}" IsVisible="{Binding Room.Flags, Mode=OneTime, Converter={StaticResource IsGMS2Converter}, ConverterParameter=invert}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerTheme>
                            <ControlTheme TargetType="ContentPresenter" x:DataType="undertale:UndertaleRoom+Layer">
                                <Setter Property="IsVisible" Value="{Binding IsVisible, Mode=OneWay}"/>
                                <Setter Property="ZIndex" Value="{Binding LayerDepth, Mode=OneWay, Converter={StaticResource NegateNumberConverter}, ConverterParameter=int}"/>
                            </ControlTheme>
                        </ItemsControl.ItemContainerTheme>
                    </ItemsControl>

                    <Rectangle Name="RoomGrid" IsHitTestVisible="False">
                        <Rectangle.Fill>
                            <MultiBinding Converter="{StaticResource RoomGridBrushConverter}">
                                <Binding Path="Room.GridWidth" Mode="OneWay"/>
                                <Binding Path="Room.GridHeight" Mode="OneWay"/>
                                <Binding Path="Room.GridThicknessPx" Mode="OneWay"/>
                            </MultiBinding>
                        </Rectangle.Fill>
                    </Rectangle>
                </Panel>
            </paz:ZoomBorder>
        </ScrollViewer>
    </Grid>
</UserControl>
