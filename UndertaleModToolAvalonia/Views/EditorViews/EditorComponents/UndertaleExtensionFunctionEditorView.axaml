<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="using:UndertaleModToolAvalonia.ViewModels.EditorViewModels.EditorComponents"
			 xmlns:controls="using:UndertaleModToolAvalonia.Controls"
			 xmlns:undertale="using:UndertaleModLib.Models"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="UndertaleModToolAvalonia.Views.EditorViews.EditorComponents.UndertaleExtensionFunctionEditorView"
			 x:DataType="vm:UndertaleExtensionFunctionEditorViewModel">
	<ScrollViewer VerticalScrollBarVisibility="Visible" AllowAutoHide="False">
		<Grid Margin="15">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="1*"/>
				<ColumnDefinition Width="3*"/>
			</Grid.ColumnDefinitions>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			<TextBlock Grid.Row="0" Grid.Column="0" Margin="3">Name</TextBlock>
			<controls:UndertaleStringReference Grid.Row="0" Grid.Column="1" Margin="3" ObjectReference="{Binding UndertaleExtensionFunction.Name}"/>

			<TextBlock Grid.Row="1" Grid.Column="0" Margin="3">External Name</TextBlock>
			<controls:UndertaleStringReference Grid.Row="1" Grid.Column="1" Margin="3" ObjectReference="{Binding UndertaleExtensionFunction.ExtName}"/>

			<TextBlock Grid.Row="2" Grid.Column="0" Margin="3">ID</TextBlock>
			<TextBox Grid.Row="2" Grid.Column="1" Margin="3" Text="{Binding UndertaleExtensionFunction.ID}"/>

			<TextBlock Grid.Row="3" Grid.Column="0" Margin="3">Kind</TextBlock>
			<TextBox Grid.Row="3" Grid.Column="1" Margin="3" Text="{Binding UndertaleExtensionFunction.Kind}"/>

			<TextBlock Grid.Row="4" Grid.Column="0" Margin="3">Return Type</TextBlock>
			<ComboBox ItemsSource="{Binding VarTypes}" SelectedItem="{Binding UndertaleExtensionFunction.RetType}"
								Grid.Row="4" Grid.Column="1" Margin="3"/>

			<TextBlock Grid.Row="5" Grid.Column="0" Margin="3">Argument Types</TextBlock>
			<Grid Grid.Row="5" Grid.Column="1" Margin="3" RowDefinitions="*,*">
				<DataGrid Grid.Row="0" ItemsSource="{Binding UndertaleExtensionFunction.Arguments, Mode=OneWay}" x:Name="ArgumentTypesList"
						  AutoGenerateColumns="False" HorizontalGridLinesBrush="LightGray" VerticalGridLinesBrush="LightGray"
						  HeadersVisibility="None" SelectionMode="Single">
					<DataGrid.Styles>
						<Style Selector="DataGridCell:selected /template/ ContentPresenter#PART_ContentPresenter">
							<Setter Property="Background" Value="#FF26A0DA"/>
						</Style>
					</DataGrid.Styles>
					<DataGrid.Columns>
						<DataGridTemplateColumn Width="*">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<ComboBox Margin="20,0,0,0" ItemsSource="{Binding $parent[UserControl].DataContext.(vm:UndertaleExtensionFunctionEditorViewModel).VarTypes}" SelectedItem="{Binding Type}"/>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
					</DataGrid.Columns>
				</DataGrid>
				<Button Grid.Row="1" HorizontalAlignment="Stretch" Margin="5" DoubleTapped="Button_DoubleTapped">
					<TextBlock Margin="5" TextAlignment="Center" FontStyle="Italic">Double click to add</TextBlock>
				</Button>
			</Grid>

			<StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2">
				<TextBlock Foreground="Red" FontStyle="Italic">
					Runner literally doesn't care about the 'Kind' value.
					<LineBreak/>
					The 'ID' does matter though, so make sure you don't have any overlaps.
				</TextBlock>
			</StackPanel>
		</Grid>
	</ScrollViewer>
</UserControl>
