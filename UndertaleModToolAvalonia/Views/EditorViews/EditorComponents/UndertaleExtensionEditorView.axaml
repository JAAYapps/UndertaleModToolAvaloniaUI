<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="using:UndertaleModToolAvalonia.ViewModels.EditorViewModels.EditorComponents"
			 xmlns:controls="using:UndertaleModToolAvalonia.Controls"
			 xmlns:undertale="using:UndertaleModLib.Models"
			 xmlns:converters="using:UndertaleModToolAvalonia.Converters"
			 xmlns:local="using:UndertaleModToolAvalonia.Views.EditorViews.EditorComponents"
			 xmlns:utils="using:UndertaleModToolAvalonia.Utilities"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="UndertaleModToolAvalonia.Views.EditorViews.EditorComponents.UndertaleExtensionEditorView"
			 x:DataType="vm:UndertaleExtensionEditorViewModel">
	<UserControl.Resources>
		<converters:ByteArrayConverter x:Key="byteArrayConverter"/>
		<converters:IsVersionAtLeastConverter x:Key="IsVersionAtLeastConverter"/>
		<converters:OptionValueConverter x:Key="OptionValueConverter"/>
	</UserControl.Resources>
	<ScrollViewer VerticalScrollBarVisibility="Visible" AllowAutoHide="False">
		<Grid Margin="15">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="1*"/>
				<ColumnDefinition Width="3*"/>
			</Grid.ColumnDefinitions>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			<TextBlock Grid.Row="0" Grid.Column="0" Margin="3">Name</TextBlock>
			<controls:UndertaleStringReference Grid.Row="0" Grid.Column="1" Margin="3" ObjectReference="{Binding UndertaleExtension.Name}"/>

			<TextBlock Grid.Row="1" Grid.Column="0" Margin="3" Text="Version"
					   IsVisible="{Binding Mode=OneTime, Converter={StaticResource IsVersionAtLeastConverter}, ConverterParameter=2023.4}"/>
			<controls:UndertaleStringReference Grid.Row="1" Grid.Column="1" Margin="3" ObjectReference="{Binding UndertaleExtension.Version}"
											   IsVisible="{Binding Mode=OneTime, Converter={StaticResource IsVersionAtLeastConverter}, ConverterParameter=2023.4}"/>

			<TextBlock Grid.Row="2" Grid.Column="0" Margin="3">Class Name</TextBlock>
			<controls:UndertaleStringReference Grid.Row="2" Grid.Column="1" Margin="3" ObjectReference="{Binding UndertaleExtension.ClassName}"/>

			<TextBlock Grid.Row="3" Grid.Column="0" Margin="3">Files</TextBlock>
			<DataGrid Grid.Row="3" Grid.Column="1" Margin="3" ItemsSource="{Binding UndertaleExtension.Files, Mode=OneWay}"
					  AutoGenerateColumns="False" utils:DataGridRows.CanUserDeleteRows="True" HorizontalGridLinesBrush="LightGray" VerticalGridLinesBrush="LightGray"
					  HeadersVisibility="Column" SelectionMode="Single">
				<DataGrid.Styles>
					<Style Selector="DataGridCell:selected /template/ ContentPresenter#PART_ContentPresenter">
						<Setter Property="Background" Value="#FF26A0DA"/>
					</Style>
				</DataGrid.Styles>
				<DataGrid.Columns>
					<DataGridTemplateColumn Header="Files" Width="*">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<controls:UndertaleObjectReference Margin="20,0,0,0" ObjectReference="{Binding ., Mode=OneWay}" ObjectType="{x:Type undertale:UndertaleExtensionFile}" CanRemove="False" CanChange="False"/>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>
				</DataGrid.Columns>
			</DataGrid>
			<Button Grid.Row="4" Grid.Column="1" HorizontalAlignment="Stretch" Content="Add new extension file" Command="{Binding AddFileCommand}"/>

			<TextBlock Grid.Row="5" Grid.Column="0" Margin="3,13,3,3" Text="Options"
					   IsVisible="{Binding Mode=OneTime, Converter={StaticResource IsVersionAtLeastConverter}, ConverterParameter=2022.6}"/>
			<DataGrid Grid.Row="5" Grid.Column="1" Margin="3,13,3,3" x:Name="OptionsGrid" ItemsSource="{Binding UndertaleExtension.Options, Mode=OneWay}"
					  AutoGenerateColumns="False" utils:DataGridRows.CanUserDeleteRows="True" HorizontalGridLinesBrush="LightGray" VerticalGridLinesBrush="LightGray"
					  HeadersVisibility="Column" SelectionMode="Single"
					  IsVisible="{Binding Mode=OneTime, Converter={StaticResource IsVersionAtLeastConverter}, ConverterParameter=2022.6}">
				<DataGrid.Styles>
					<Style Selector="DataGridCell:selected /template/ ContentPresenter#PART_ContentPresenter">
						<Setter Property="Background" Value="#FF26A0DA"/>
					</Style>
				</DataGrid.Styles>
				<DataGrid.Columns>
					<DataGridTemplateColumn Header="Name" Width="*">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<controls:UndertaleStringReference Margin="20,0,0,0" ObjectReference="{Binding Name}"/>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>
					<DataGridTemplateColumn Header="Value" Width="*">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<ContentControl Content="{Binding Kind, Mode=OneWay}">
									<ContentControl.ContentTemplate>
										<local:OptionValueTemplateSelector>
											<local:OptionValueTemplateSelector.StringTemplate>
												<DataTemplate>
													<TextBox Text="{Binding $parent[ContentControl].DataContext.(undertale:UndertaleExtensionOption).Value.Content}"/>
												</DataTemplate>
											</local:OptionValueTemplateSelector.StringTemplate>
											<local:OptionValueTemplateSelector.BooleanTemplate>
												<DataTemplate>
													<CheckBox IsChecked="{Binding $parent[ContentControl].DataContext.(undertale:UndertaleExtensionOption).Value.Content,
																		  Converter={StaticResource OptionValueConverter}, ConverterParameter=boolean}"
															  VerticalAlignment="Center" HorizontalAlignment="Center"/>
												</DataTemplate>
											</local:OptionValueTemplateSelector.BooleanTemplate>
											<local:OptionValueTemplateSelector.NumberTemplate>
												<DataTemplate>
													<TextBox Text="{Binding $parent[ContentControl].DataContext.(undertale:UndertaleExtensionOption).Value.Content,
																	Converter={StaticResource OptionValueConverter}, ConverterParameter=number}"/>
												</DataTemplate>
											</local:OptionValueTemplateSelector.NumberTemplate>
										</local:OptionValueTemplateSelector>
									</ContentControl.ContentTemplate>
								</ContentControl>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>
					<DataGridTemplateColumn Header="Kind" Width="*">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<ComboBox ItemsSource="{Binding $parent[UserControl].DataContext.(vm:UndertaleExtensionEditorViewModel).OptionKinds}" SelectedItem="{Binding Kind}"
										  SelectionChanged="KindComboBox_SelectionChanged"/>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>
				</DataGrid.Columns>
			</DataGrid>
			<Button Grid.Row="6" Grid.Column="1" HorizontalAlignment="Stretch" Content="Add new extension option" Command="{Binding AddOptionCommand}" Margin="0,0,0,6"
					IsVisible="{Binding Mode=OneTime, Converter={StaticResource IsVersionAtLeastConverter}, ConverterParameter=2022.6}"/>

			<TextBlock Grid.Row="7" Grid.Column="0" Margin="3" IsVisible="{Binding IsProductIdVisible}">Product ID</TextBlock>
			<TextBox Grid.Row="7" Grid.Column="1" Margin="3" IsVisible="{Binding IsProductIdVisible}" Text="{Binding ProductIdData, Mode=TwoWay, Converter={StaticResource byteArrayConverter}}"/>

			<StackPanel Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2">
				<TextBlock Foreground="Red" FontStyle="Italic">
					THINGS TO NOTE:
					<LineBreak/>
					- Keep in mind that .gml files are either not present, or will be empty. (e.g. no functions)
					<LineBreak/>
					Because they are prebaked into GML scripts. That is completely normal.
				</TextBlock>
			</StackPanel>
		</Grid>
	</ScrollViewer>
</UserControl>
