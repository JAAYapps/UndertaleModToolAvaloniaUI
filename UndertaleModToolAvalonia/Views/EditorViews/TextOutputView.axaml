<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:vm="using:UndertaleModToolAvalonia.ViewModels.EditorViewModels"
        x:DataType="vm:TextOutputViewModel"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="400"
        x:Class="UndertaleModToolAvalonia.Views.EditorViews.TextOutputView"
        Title="{Binding Title}" Height="400" Width="500">
	<Grid Margin="10">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<TextBlock Grid.Row="0" Margin="3" Text="{Binding Label}" TextWrapping="Wrap"/>
		<TextBox Grid.Row="1" Margin="3" Name="OutputBox" Text="{Binding Text}" IsReadOnly="{Binding IsReadOnly}" AcceptsReturn="{Binding IsMultiline}" NewLine="&#10;" VerticalContentAlignment="Top"/>
		<Button Grid.Row="2" Margin="3" Name="CloseButton" Content="OK" MinWidth="80" HorizontalAlignment="Right" HorizontalContentAlignment="Center"/>
	</Grid>
</Window>
